# Database URL configuration
# Option 1: MySQL
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agrimind_ai

# Option 2: SQLite (zero configuration needed, local file)
# DATABASE_URL=sqlite:///./database/agrimind_ai.db

# JWT Secret Key for token encoding/decoding
JWT_SECRET_KEY=your_64_character_hex_secret_key_here

# OpenWeatherMap API Key for Live Agricultural Weather & 5-Day Forecasts
# Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Google Gemini API Key for AI Farmer Assistant Chatbot
# Get free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
